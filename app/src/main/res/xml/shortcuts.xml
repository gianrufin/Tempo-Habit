            <extra android:name="shortcut_action" android:value="add_task" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="start_pomodoro"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_start_pomodoro"
