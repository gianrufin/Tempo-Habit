<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_habit"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_add_habit"
        android:shortcutLongLabel="@string/shortcut_add_habit">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.tempo.app"
            android:targetClass="com.tempo.app.MainActivity">
            <extra android:name="shortcut_action" android:value="add_habit" />
        </intent>
    </shortcut>
    <shortcut
